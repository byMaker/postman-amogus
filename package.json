{
    "name": "app",
    "private": true,
    "version": "1.5.13",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test:unit": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:ui": "playwright test",
        "coverage:badge": "./scripts/update-coverage.sh",
        "posttest:coverage": "npm run coverage:badge",
        "lint": "svelte-check --compiler-warnings \"a11y-*:error\""
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/svelte": "^5.4.2",
        "@vitest/coverage-v8": "^4.1.10",
        "autoprefixer": "^10.5.4",
        "daisyui": "^5.6.18",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "jsdom": "^30.0.1",
        "mysql2": "^3.23.0",
        "postcss": "^8.5.19",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@fontsource/balsamiq-sans": "^5.3.0",
        "@fontsource/golos-text": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/jura": "^5.3.0",
        "@fontsource/montserrat-alternates": "^5.3.0",
        "@fontsource/oswald": "^5.3.0",
        "@fontsource/raleway": "^5.3.0",
        "@fontsource/roboto": "^5.3.0",
        "chart.js": "^4.5.1",
        "phosphor-svelte": "^3.1.0",
        "svelte-chartjs": "^4.0.1"
    }
}
